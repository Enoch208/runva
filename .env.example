# CreateOS Sandbox (host-only). API key from your createos.sh dashboard.
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# LLM for test + patch generation (host-only). One of:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional app behavior
RUNVA_MAX_REPAIR_RETRIES=2
RUNVA_MAX_ACTIVE_RUNS=1
RUNVA_MAX_RUN_MS=300000
RUNVA_FRESH_VERIFIER_VM=true
RUNVA_ACCESS_CODE=
